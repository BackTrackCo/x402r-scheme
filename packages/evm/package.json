{
  "name": "@x402r/evm",
  "version": "0.0.2",
  "type": "module",
  "description": "Escrow payment scheme for x402 using Base Commerce Payments",
  "license": "MIT",
  "author": "x402r",
  "repository": {
    "type": "git",
    "url": "https://github.com/BackTrackCo/x402r-scheme.git",
    "directory": "packages/evm"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./escrow/client": {
      "import": {
        "types": "./dist/esm/escrow/client/index.d.ts",
        "default": "./dist/esm/escrow/client/index.js"
      },
      "require": {
        "types": "./dist/cjs/escrow/client/index.d.cts",
        "default": "./dist/cjs/escrow/client/index.cjs"
      }
    },
    "./escrow/server": {
      "import": {
        "types": "./dist/esm/escrow/server/index.d.ts",
        "default": "./dist/esm/escrow/server/index.js"
      },
      "require": {
        "types": "./dist/cjs/escrow/server/index.d.cts",
        "default": "./dist/cjs/escrow/server/index.cjs"
      }
    },
    "./escrow/facilitator": {
      "import": {
        "types": "./dist/esm/escrow/facilitator/index.d.ts",
        "default": "./dist/esm/escrow/facilitator/index.js"
      },
      "require": {
        "types": "./dist/cjs/escrow/facilitator/index.d.cts",
        "default": "./dist/cjs/escrow/facilitator/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "peerDependencies": {
    "@x402/core": "^2.4.0",
    "@x402/evm": "^2.0.0",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
