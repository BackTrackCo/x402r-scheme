{
  "name": "@x402r/evm",
  "version": "0.0.3",
  "description": "Escrow payment scheme for x402 using Base Commerce Payments",
  "license": "MIT",
  "author": "x402r",
  "repository": {
    "type": "git",
    "url": "https://github.com/BackTrackCo/x402r-scheme.git",
    "directory": "packages/evm"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.mts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./escrow/client": {
      "import": {
        "types": "./dist/esm/escrow/client/index.d.mts",
        "default": "./dist/esm/escrow/client/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/escrow/client/index.d.ts",
        "default": "./dist/cjs/escrow/client/index.js"
      }
    },
    "./escrow/server": {
      "import": {
        "types": "./dist/esm/escrow/server/index.d.mts",
        "default": "./dist/esm/escrow/server/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/escrow/server/index.d.ts",
        "default": "./dist/cjs/escrow/server/index.js"
      }
    },
    "./extensions/attestation": {
      "import": {
        "types": "./dist/esm/extensions/attestation/index.d.mts",
        "default": "./dist/esm/extensions/attestation/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/extensions/attestation/index.d.ts",
        "default": "./dist/cjs/extensions/attestation/index.js"
      }
    },
    "./escrow/facilitator": {
      "import": {
        "types": "./dist/esm/escrow/facilitator/index.d.mts",
        "default": "./dist/esm/escrow/facilitator/index.mjs"
      },
      "require": {
        "types": "./dist/cjs/escrow/facilitator/index.d.ts",
        "default": "./dist/cjs/escrow/facilitator/index.js"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier -c .prettierrc --write \"**/*.{ts,js,cjs,json,md}\"",
    "format:check": "prettier -c .prettierrc --check \"**/*.{ts,js,cjs,json,md}\""
  },
  "peerDependencies": {
    "@x402/core": "^2.8.0",
    "@x402/evm": "^2.0.0",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  }
}
