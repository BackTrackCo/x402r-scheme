# Required: the merchant's receiving address
EVM_ADDRESS=

# Required: the address with capture/void/refund authority on the escrow
# (committed on-chain as PaymentInfo.operator). May be an EOA or a smart
# contract that forwards to AuthCaptureEscrow.
CAPTURE_AUTHORIZER=

# Required: base URL of the auth-capture facilitator
FACILITATOR_URL=http://localhost:4022

# Optional
PORT=4021
